{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2022",
    "lib": ["es2023"],
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "maxNodeModuleJsDepth": 0,
    "types": ["node", "vscode"]
  },
  "include": ["extension.js", "lib/**/*.js"]
}
